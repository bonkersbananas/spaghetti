{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spaghetti",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // The client is built by Vite and served as static assets. Client routes
  // get index.html from the Worker (src/worker/spa.ts), not from the assets' single-page fallback: that answers a
  // missing /assets/*.js with index.html too, and a stale tab then fails with a MIME error instead of a 404. /api/*, /mcp and the OAuth endpoints (/oauth/*, /.well-known/*) always reach the Worker first,
  // and so does / alone, which is the app when signed in and the landing page (landing.html) otherwise (src/worker/home.ts).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/api/*", "/mcp", "/oauth/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spaghetti",
      // The deployed database (spaghetti.day, see docs/deploy.md).
      "database_id": "d99aafba-1ebb-4a7c-bd39-345958ee888d",
      // Local development, the e2e servers and the container key their local
      // database by this id, so keeping the old placeholder here means state
      // created before the deploy stays where it was. Never used remotely.
      "preview_database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      // Photos, from phase 2. Images are resized in the browser before upload.
      "binding": "PHOTOS",
      "bucket_name": "spaghetti-photos"
    }
  ],
  // The domain is the only way in: no workers.dev URL, no preview URLs.
  // Wrangler creates the DNS record for the custom domain on deploy.
  "routes": [{ "pattern": "spaghetti.day", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Daily at 04:00 UTC: removes ideas and photos deleted more than 30 days
  // ago, with their R2 objects (src/worker/photos.ts, purgeDeleted).
  // Every 5 minutes: the "how did it go?" nudges (src/worker/push/nudges.ts); a cheap query on open attempts.
  "triggers": { "crons": ["*/5 * * * *", "0 4 * * *"] },
  "vars": {
    // Web push (docs/deploy.md, "Push notifications"). The public key is not secret; its private half is the
    // VAPID_PRIVATE_KEY secret, set with wrangler secret put and kept across deploys.
    "VAPID_PUBLIC_KEY": "BH-5N3yXrnBw6sRw6FtNUKjoOmcZI8-Dj1JWPn3bJ64BYGEiznM1EUjzJWsUuKtErRaQ-OeOrH-mbE3Zdqoatng",
    "VAPID_SUBJECT": "https://spaghetti.day",
    // Passkeys: the relying party (docs/decisions/0026). The dev server, the e2e tests and `pnpm start` override
    // these with localhost (vite.config.ts, scripts/lib/local-app.ts, scripts/start.ts).
    "WEBAUTHN_RP_ID": "spaghetti.day",
    "WEBAUTHN_ORIGINS": "https://spaghetti.day"
  },
  "observability": { "enabled": true }
}
