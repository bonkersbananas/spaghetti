--- a/engine/deps/build-deps.sh
+++ b/engine/deps/build-deps.sh
@@ -221,10 +221,21 @@ step_cgal() {     # CGAL 5.6.3 (Orca pin), header-only.
   # does), CGAL::CGAL carries CGAL_DISABLE_GMP=1 and the exact number types come from Boost.Multiprecision
   # (Boost >= 1.80). FFF slicing only evaluates exact predicates (Voronoi checks behind Arachne), whose
   # results do not depend on the exact number type.
-  cmake_dep cgal-5.6.3 "$SRC/CGAL-5.6.3"
+  cmake_dep cgal-6.2.1 "$SRC/CGAL-6.2.1"
+  # CGAL 6's Surface_sweep_2 includes Boost.Interval, whose hw_rounding.hpp stops with "Please specify rounding control
+  # mechanism" on wasm (no hardware rounding, and Boost's fenv.hpp refuses it). Keep Boost's own no-op rounding_control:
+  # the interval code behind it (an algebraic kernel) is never run by the engine, and CGAL's own intervals have
+  # CGAL_ALWAYS_ROUND_TO_NEAREST.
+  sed -i 's|^#  error Boost.Numeric.Interval: Please specify rounding control mechanism\.$|/* wasm: no rounding control (the engine) */|' \
+    "$PREFIX/include/boost/numeric/interval/hw_rounding.hpp"
 }
 
 # ---- 5. Small compiled libraries --------------------------------------------------------------------
+step_expat() {    # expat 2.10.0 (Orca 2.5.1 pins it; the bundled deps_src/expat is gone)
+  cmake_dep expat-2.10.0 "$SRC/expat-2.10.0" \
+    -DEXPAT_SHARED_LIBS=OFF -DEXPAT_DTD=ON -DEXPAT_GE=ON -DEXPAT_BUILD_TOOLS=OFF -DEXPAT_BUILD_EXAMPLES=OFF \
+    -DEXPAT_BUILD_TESTS=OFF -DEXPAT_BUILD_DOCS=OFF -DEXPAT_BUILD_FUZZERS=OFF -DEXPAT_BUILD_PKGCONFIG=OFF
+}
