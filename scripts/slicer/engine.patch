   cmake_dep nlopt-2.5.0 "$SRC/nlopt-2.5.0" --target nlopt \
     -DNLOPT_CXX=OFF -DNLOPT_PYTHON=OFF -DNLOPT_OCTAVE=OFF -DNLOPT_MATLAB=OFF -DNLOPT_GUILE=OFF \
@@ -404,7 +415,7 @@ step_verify() {
   node "$BLD/smoke/smoke.js"
 }
 
