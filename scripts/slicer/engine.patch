diff --git a/engine/shims/tbb-serial/oneapi/tbb/parallel_invoke.h b/engine/shims/tbb-serial/oneapi/tbb/parallel_invoke.h
new file mode 100644
index 0000000..da5edf1
--- /dev/null
+++ b/engine/shims/tbb-serial/oneapi/tbb/parallel_invoke.h
@@ -0,0 +1,20 @@
+// Serial oneTBB shim: tbb::parallel_invoke runs its functions one after the other, in order.
+#pragma once
+
+#include <utility>
+
+#include "detail/_serial.h"
+
+namespace oneapi {
+namespace tbb {
+
+template<typename F> void parallel_invoke(F &&f) { std::forward<F>(f)(); }
+template<typename F, typename... Fs> void parallel_invoke(F &&f, Fs &&...fs)
+{
+    std::forward<F>(f)();
+    parallel_invoke(std::forward<Fs>(fs)...);
+}
+
+} // namespace tbb
+} // namespace oneapi
+
diff --git a/engine/shims/tbb-serial/oneapi/tbb/parallel_sort.h b/engine/shims/tbb-serial/oneapi/tbb/parallel_sort.h
new file mode 100644
index 0000000..4255ea7
--- /dev/null
+++ b/engine/shims/tbb-serial/oneapi/tbb/parallel_sort.h
@@ -0,0 +1,27 @@
+// Serial oneTBB shim: tbb::parallel_sort is std::sort.
+#pragma once
+
+#include <algorithm>
+#include <functional>
+#include <iterator>
+
+#include "detail/_serial.h"
+
+namespace oneapi {
+namespace tbb {
+
+template<typename RandomIt, typename Compare> void parallel_sort(RandomIt first, RandomIt last, const Compare &comp)
+{
+    std::sort(first, last, comp);
+}
+template<typename RandomIt> void parallel_sort(RandomIt first, RandomIt last)
+{
+    std::sort(first, last);
+}
+template<typename Range> void parallel_sort(Range &&range)
+{
+    std::sort(std::begin(range), std::end(range));
+}
+
+} // namespace tbb
+} // namespace oneapi
