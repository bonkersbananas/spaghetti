# The slicing engine Spaghetti builds and serves (docs/slicer.md). Sourced by scripts/slicer/build.sh and read by the
# release workflow. Moving any of these means a new engine release (a `slicer-v*` tag) and a new engine.json.

# The Muon3D Slicer Engine: OrcaSlicer's libslic3r in WebAssembly, AGPL-3.0.
ENGINE_REPO=https://github.com/Muon-3D/muon3d-slicer-engine.git
ENGINE_TAG=v0.6.1
ENGINE_COMMIT=adaee71fcc81a851075867792bacd234d6bede35
# OrcaSlicer at the commit the engine's orca/ submodule pins at that tag (the engine's fork, branch muon3d-wasm, tag
# muon3d-wasm/2026-09-24): OrcaSlicer's main of 2026-09-24 with its pull request #13777, "2.5.0-dev".
ORCA_REPO=https://github.com/Muon-3D/OrcaSlicer
ORCA_COMMIT=2d1163eb6f5228de605150e3b4800081947070eb
ORCA_UPSTREAM_COMMIT=432debfc74a7e62e84b1af420804c47590ace43f
ORCA_VERSION=2.5.0-dev

# The single-threaded engine is reproducible: a build of these commits must be byte for byte the engine's own release
# (variants.st.sha256 in its manifest.json). build.sh stops when it isn't, unless SLICER_ALLOW_DIFFERENT=1.
ENGINE_ST_WASM_SHA256=290e5825b14a0e9cbed453304af32644c2f1e269e413cf0bf37d7efc5c1ab6ea
ENGINE_ST_MJS_SHA256=46602f1e095e45ddd8a96667486d0f4210dd967752e383e36207187474c5f53d

# The engine's release carries the Corresponding Source of that build; ours re-publishes the same files, checked here.
ENGINE_RELEASE=https://github.com/Muon-3D/muon3d-slicer-engine/releases/download/v0.6.1
ENGINE_SOURCE_ASSETS="muon3d-slicer-engine-0.6.1-source.tar.gz:c4b9ffe597d48cb0b60767a9356bd55660a702ea5b89bd8147990148b335a1f3 orcaslicer-2d1163eb6f-source.tar.xz:7b6f5e064057d7ff77268eedcc7bf60df351f0f993ea36d8dfc73f3a94137804 third-party-sources-348d374e2e28.tar:57eac1efb0d83f7424b24a9b9c9271d4d9951d9e1f926d77a968b1a93276c5b1"
