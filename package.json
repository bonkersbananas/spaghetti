{
  "name": "spaghetti",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm db:migrate && vite",
    "dev:seed": "node scripts/dev-seed.ts",
    "build": "vite build",
    "preview": "pnpm db:migrate && vite build && vite preview",
    "start": "node scripts/start.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check . && node scripts/check-design.ts",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "doctor": "node scripts/doctor.ts",
    "screenshots": "node scripts/screenshots.ts",
    "screenshots:compare": "node scripts/screenshots-compare.ts",
    "new": "node scripts/new.ts",
    "icons": "node scripts/icons.ts",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:export": "node scripts/db-export.ts",
    "ship": "node scripts/ship.ts",
    "user:add": "node scripts/user-add.ts",
    "agent:add": "node scripts/agent-add.ts",
    "vapid:generate": "node scripts/vapid-keys.ts",
    "bridge": "node bridge/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "basic-ftp": "^6.2.6",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "motion": "^14.10.1",
    "mqtt": "^5.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "aedes": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
