# The consent screen must never be framed: a hidden frame over "Allow" would be clickjacking. (The page itself is
# served by the Worker, which sets these headers and more on every page: src/worker/page-headers.ts. Keep both.)
/authorize
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# The installer is read with curl and, by careful people, in a browser: plain text, never cached stale.
/bridge/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# The landing page's script, styles and pictures (landing.html, src/landing): their names are hashed, so they never change.
/assets/landing/*
  Cache-Control: public, max-age=31536000, immutable

# The picture a shared link to spaghetti.day shows (pnpm landing:shots makes it).
/og.jpg
  Cache-Control: public, max-age=86400
